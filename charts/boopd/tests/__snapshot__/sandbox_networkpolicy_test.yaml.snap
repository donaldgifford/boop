snapshot - cilium:
  1: |
    apiVersion: cilium.io/v2
    kind: CiliumNetworkPolicy
    metadata:
      labels:
        app.kubernetes.io/component: sandbox
        app.kubernetes.io/instance: RELEASE-NAME
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: boopd
        app.kubernetes.io/version: 0.0.0-dev
        helm.sh/chart: boopd-0.0.0-dev
      name: RELEASE-NAME-boopd-sandbox-gradle
      namespace: NAMESPACE
    spec:
      egress:
        - toEndpoints:
            - matchLabels:
                k8s:io.kubernetes.pod.namespace: kube-system
                k8s:k8s-app: kube-dns
          toPorts:
            - ports:
                - port: "53"
                  protocol: ANY
              rules:
                dns:
                  - matchName: github.com
                  - matchName: api.github.com
                  - matchName: codeload.github.com
                  - matchName: objects.githubusercontent.com
                  - matchName: release-assets.githubusercontent.com
                  - matchName: ghcr.io
                  - matchName: repo1.maven.org
                  - matchPattern: '*.gradle.org'
        - toFQDNs:
            - matchName: github.com
            - matchName: api.github.com
            - matchName: codeload.github.com
            - matchName: objects.githubusercontent.com
            - matchName: release-assets.githubusercontent.com
            - matchName: ghcr.io
            - matchName: repo1.maven.org
            - matchPattern: '*.gradle.org'
          toPorts:
            - ports:
                - port: "443"
                  protocol: TCP
      endpointSelector:
        matchLabels:
          boopd.dev/profile: gradle
          boopd.dev/sandbox: "true"
      ingress:
        - {}
  2: |
    apiVersion: cilium.io/v2
    kind: CiliumNetworkPolicy
    metadata:
