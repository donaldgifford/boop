{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "boopd Helm chart values",
  "description": "Subset of values.yaml that is enforced at `helm install`/`helm upgrade` time. Unknown keys are accepted (no additionalProperties: false) — removed knobs are caught by the validateRemovedValues template guard instead.",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 3481,
      "description": "Must exceed the RunRenovate StartToClose (58m = 3480s)."
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "tag": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "configMap": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "existingConfigMap": {
          "type": "string"
        }
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "stringData": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "existingSecret": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "httpPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "metricsPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "interval": {
          "type": "string"
        }
      }
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "alerts": {
          "type": "object",
          "properties": {
            "replicasUnavailable": {
              "$ref": "#/$defs/alertOverride"
            },
            "containerRestarting": {
              "$ref": "#/$defs/alertOverride"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "alertOverride": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "for": {
          "type": "string"
        },
        "severity": {
          "type": "string"
        },
        "threshold": {
          "type": "number"
        }
      }
    }
  }
}
