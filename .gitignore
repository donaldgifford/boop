# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Go-specific (supplements registry-root .gitignore)

# Root-level binary from a bare `go build` (the justfile targets write
# to build/bin/, but `go build ./cmd/...` drops it here).
/boop
/dist/
/bin/
build/

# IDE
.vscode/
.idea/

# Local env
.env
.env.local

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Code coverage profiles and other test artifacts

# Test binary, built with `go test -c` and code coverage profiles and other test artifacts
*.test
*.out
coverage.*
*.coverprofile
profile.cov
*.test

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# Goreleaser snapshot output (created by `just release-local`)
dist/

# mkdocs build output (`mkdocs build` / `mkdocs build --strict`).
# The published site is built by CI from source, never from a
# committed tree.
site/

# Helm chart packages (output of `helm package`)
*.tgz

# donald-loop runtime state
.claude/donald-loop.local.md

# Keys and certs
*.pem
*.cert

# OS files
.DS_Store
Thumbs.db
